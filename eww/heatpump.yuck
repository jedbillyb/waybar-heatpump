; heat pump - control panel for the ECHONET Lite aircon.
;
; Included from eww.yuck. The listener runs only while the window is open, so
; nothing polls the device when the panel is closed.
;
; The panel is meant to read as the bar continuing downwards rather than as a
; floating card: same background and font as waybar, square corners, flush
; against the bar's bottom edge, and left-aligned with the module that opened
; it. `xpos` comes from panel-position.py, which measures the bar to find
; where the module actually is - waybar exposes no geometry, and the module
; drifts as the modules to its right change width.
;
; It carries no accent stripe: sharing waybar's exact background and sitting
; flush against it is enough to read as attached, and a coloured stub on top
; of that just looked stuck on.

(deflisten hp
  :initial `{"ok":false,"reason":"connecting","fanbars":[],"modes":[]}`
  "python3 ~/.config/eww/heatpump-listen.py")

(defvar HP "~/.config/waybar/heatpump-status.py")

;; ── pieces ──────────────────────────────────────────────────────────────────

(defwidget hp-reading [label value]
  (box :class "hp-reading" :orientation "h" :space-evenly false
    (label :class "hp-key" :text label :xalign 0 :hexpand true)
    (label :class "hp-val" :text value :xalign 1)))

(defwidget hp-mode [m]
  (eventbox :cursor "pointer" :onclick "${HP} mode ${m.name}" :hexpand true
    (label :class "hp-word ${m.active ? "active" : ""}" :text {m.name})))

; Clicking segment n sets speed n outright - quicker than stepping, and the
; filled run doubles as the readout.
(defwidget hp-seg [b]
  (eventbox :cursor "pointer" :onclick "${HP} fan ${b.level}"
    (label :class "hp-seg ${b.filled ? "filled" : ""}" :text "▊")))

;; ── the panel ───────────────────────────────────────────────────────────────

(defwidget hp-body [xpos editing]
  (box :orientation "v" :space-evenly false :halign "center"
    (box :class "hp-panel" :orientation "v" :space-evenly false

      (box :class "hp-head" :orientation "h" :space-evenly false
        ; Spelled out here, unlike the bar module's "hp". The bar is fighting
        ; for horizontal space against every other module; the panel is not.
        (label :class "hp-title" :text "heat pump" :xalign 0 :hexpand true)
        (label :class "hp-power ${hp.on ? "on" : "off"}"
               :text {hp.power_text ?: ""} :xalign 1))

      ; Nothing worth drawing or pressing if the unit is unreachable.
      (box :visible {hp.ok == false} :class "hp-down"
        (label :class "hp-key" :text {hp.reason ?: "unreachable"} :xalign 0))

      (box :visible {hp.ok} :orientation "v" :space-evenly false

        (box :class "hp-dial" :orientation "h" :space-evenly false :spacing 0
             :halign "center"
          (eventbox :cursor "pointer" :onclick "${HP} cooler"
            (label :class "hp-step" :text "−"))
          ; Click the number to type a temperature.
          ;
          ; eww 0.5 has only exclusive keyboard focus - a focusable window
          ; swallows every keystroke on the system while it is open - so the
          ; panel itself must not be focusable, or you cannot type anywhere
          ; else on the desktop. Editing therefore swaps to an identical but
          ; focusable window, which holds the keyboard only while you type.
          (box :class "hp-target" :orientation "v" :space-evenly false
            (box :orientation "h" :space-evenly false :halign "center"
              (input :class "hp-big hp-entry" :visible editing :hexpand false
                     :xalign 0.5
                     :value {hp.setpoint_input}
                     :onaccept "${HP} settemp {} && ~/.config/eww/heatpump-panel.sh --show ${xpos}")
              (eventbox :visible {editing == false} :cursor "text"
                        :onclick "~/.config/eww/heatpump-panel.sh --edit ${xpos}"
                ; Centred on the digits, not on digits-plus-degree. The box
                ; carries a left margin of one degree-glyph, and GTK splits an
                ; asymmetric margin when centring, so the group shifts right by
                ; half a glyph - exactly cancelling the degree sign's width on
                ; the other side.
                (box :class "hp-bignum" :orientation "h" :space-evenly false
                     :halign "center"
                  (label :class "hp-big" :text {hp.setpoint_big})
                  (label :class "hp-big hp-degree" :text "°"))))
            (eventbox :visible editing :cursor "pointer"
                      :onclick "~/.config/eww/heatpump-panel.sh --show ${xpos}"
              (label :class "hp-caption" :text "enter to set" :xalign 0.5))
            (label :class "hp-caption" :visible {editing == false}
                   :text "target" :xalign 0.5))
          (eventbox :cursor "pointer" :onclick "${HP} warmer"
            (label :class "hp-step" :text "+")))

        (box :class "hp-rule")

        (box :class "hp-readings" :orientation "v" :space-evenly false
          (hp-reading :label "room"    :value {hp.room_temp})
          (hp-reading :label "outside" :value {hp.outdoor_temp}))

        (box :class "hp-rule")

        (box :class "hp-row" :orientation "h" :space-evenly false
          (label :class "hp-key" :text "mode")
          (box :orientation "h" :space-evenly true :spacing 2 :hexpand true
            (for m in {hp.modes} (hp-mode :m m))))

        (box :class "hp-row" :orientation "h" :space-evenly false :spacing 0
          (label :class "hp-key" :text "fan")
          (box :class "hp-bars" :orientation "h" :space-evenly false :spacing 2
            (for b in {hp.fanbars} (hp-seg :b b)))
          (label :class "hp-val" :text {hp.fan_text} :hexpand true :xalign 0)
          (eventbox :cursor "pointer" :onclick "${HP} fan auto"
            (label :class "hp-word ${hp.fan_auto ? "active" : ""}"
                   :text "auto")))

        (label :class "hp-fault" :visible {hp.fault} :text "fault reported"
               :xalign 0)))))

(defwindow heatpump [xpos]
  :monitor 0
  :stacking "ov"
  :focusable false          ; see the comment on the target above
  :geometry (geometry :x "${xpos}px" :y "0px"
                      :width "268px"
                      :anchor "top left")
  (hp-body :xpos xpos :editing false))


; The focusable twin of the panel, shown only while typing a temperature.
(defwindow heatpump-edit [xpos]
  :monitor 0
  :stacking "ov"
  :focusable true
  :geometry (geometry :x "${xpos}px" :y "0px"
                      :width "268px"
                      :anchor "top left")
  (hp-body :xpos xpos :editing true))


;; ── click-off backdrop ──────────────────────────────────────────────────────

; A layer-shell panel cannot see clicks that land outside it, so closing on a
; click elsewhere needs something to catch them: a full-screen, fully
; transparent window sitting one layer below the panel. Clicking it closes
; everything; clicks on the panel never reach it, because the panel is above.
;
; Deliberately not focusable - it only needs the pointer. Escape is handled by
; a sway binding installed while the panel is open, since eww 0.5 has no key
; events at all.
(defwindow heatpump-backdrop []
  :monitor 0
  :stacking "fg"
  :focusable false
  :geometry (geometry :x "0px" :y "0px"
                      :width "100%" :height "100%"
                      :anchor "top left")
  (eventbox :onclick "~/.config/eww/heatpump-panel.sh --close"
    (box :class "hp-backdrop")))
